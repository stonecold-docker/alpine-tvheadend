#!/bin/sh

set -e

docker-install -r -u -c goreman su-exec tvheadend tvheadend-dvb-scan ffmpeg soca 

rm -rf /build

mkdir -p /build/scan
cd /build/scan
wget https://github.com/forumi0721/arch_stonecold_PKGBUILDs/raw/master/tvheadend-extra/tvheadend-extra.tar.xz -q -O - | tar Jx
cp tvheadend-extra/usr/share/tvheadend/data/dvb-scan/atsc/* /usr/share/tvheadend/data/dvb-scan/atsc/
cd /

rm -rf /build

mkdir -p /conf.d
mkdir -p /conf.d/tvheadend
chown tvheadend:video /conf.d/tvheadend

mkdir -p /data

