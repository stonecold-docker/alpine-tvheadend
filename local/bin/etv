#!/bin/sh

if [ -z "${1}" ]; then
	exit 1
fi

if [ ! -x /usr/local/bin/pipestream ]; then
	exit 1
fi

fn_run() {
	#if curl -L "${1}" &> /dev/null ; then
	if wget -q --timeout=5 -O - "${1}" &> /dev/null ; then
		exec /usr/local/bin/pipestream "${1}" "${2}"
	fi
}

id=${1}

for edge in 1 2
do
	for sb in sb ""
	do
		url=http://edge${edge}.everyon.tv/etv${edge}${sb}/phd${id}/playlist.m3u8
		fn_run "${url}" "${2}" &
	done
done

