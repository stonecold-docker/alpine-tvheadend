#!/bin/sh

if [ -z "${1}" ]; then
	exit 1
fi

if [ "${2}" = "audio" ]; then
	#ffmpeg -re -v error -fflags +genpts -i "${1}" -c copy -vn -f mpegts pipe:1
	ffmpeg -v error -fflags +genpts -filter:a loudnorm -i "${1}" -c copy -vn -f mpegts pipe:1
else
	#ffmpeg -re -v error -fflags +genpts -i "${1}" -c copy -f mpegts pipe:1
	ffmpeg -v error -fflags +genpts -filter:a loudnorm -i "${1}" -c copy -f mpegts pipe:1
fi

