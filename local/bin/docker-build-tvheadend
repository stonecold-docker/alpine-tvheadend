#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB=""
PKG_DEV="avahi-dev bash bsd-compat-headers build-base cmake coreutils dbus-dev ffmpeg-dev findutils gettext-dev git gnu-libiconv-dev libdvbcsa-dev libhdhomerun-dev libva-dev libvpx-dev linux-headers musl-dev openssl-dev>3 opus-dev pngquant python3 uriparser-dev wget x264-dev x265-dev zlib-dev"
if [ "$(uname -m)" = "x86_64" ]; then
	PKG_DEV="${PKG_DEV} libva-intel-driver"
fi
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Preparing Installation"
#rm -rf /usr/include/iconv.h && \
#cp /usr/include/gnu-libiconv/iconv.h /usr/include/iconv.h
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing tvheadend"
#export PYTHONHTTPSVERIFY=0
mkdir -p /build
cd /build
git clone https://github.com/tvheadend/tvheadend.git
#sed -i -e 's/verify=PCLOUD_CA_CERTS/verify=False/g' /build/tvheadend/support/pcloud.py
cd tvheadend
./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --localstatedir=/var \
	--disable-doc \
	--disable-execinfo \
	--disable-ffmpeg_static \
	--disable-hdhomerun_static \
	--disable-libfdkaac_static \
	--disable-libmfx_static \
	--disable-libopus_static \
	--disable-libtheora_static \
	--disable-libvorbis_static \
	--disable-libvpx_static \
	--disable-libx264_static \
	--disable-libx265_static \
	--enable-bundle \
	--enable-dvbcsa \
	--enable-hdhomerun_client \
	--enable-kqueue \
	--enable-libav \
	--enable-nvenc \
	--enable-pngquant \
	--enable-qsv \
	--python=python3
make -j 4
mkdir -p /output
make DESTDIR=/output install
cd /
rm -rf /build

#cd /output/usr/share/tvheadend/src/webui/static
#wget -O - -q https://github.com/dave-p/TVHadmin-JS/archive/master.tar.gz | tar zxf -
#mv TVHadmin-JS-master TVHadmin-JS
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

